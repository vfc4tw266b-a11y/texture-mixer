  "authors": ["Du"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["de.texturemixer.TextureMixerClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
